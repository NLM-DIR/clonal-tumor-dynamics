Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"h", "=", 
  RowBox[{"{", "\n", "\t", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"k", "*", "m"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", "*", "gi"}], ")"}]}], ",", 
      "                                                    ", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"k", "*", "gi"}], ")"}]}], "/", 
       RowBox[{"(", 
        RowBox[{"2", "*", "m"}], ")"}]}], ",", "  ", 
      RowBox[{
       RowBox[{"-", "c"}], "*", "p"}]}], "}"}], ",", "\n", "\t", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"m", "^", "2"}], ")"}]}], "/", 
       RowBox[{"(", 
        RowBox[{"2", "*", "gi"}], ")"}]}], ",", 
      "                                                   ", 
