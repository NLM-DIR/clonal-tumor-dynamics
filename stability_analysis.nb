Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"d", " ", "P"}], 
     RowBox[{"d", " ", "t"}]], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["g", "P"], 
      RowBox[{"P", "(", "t", ")"}]}], "+", 
     RowBox[{"k", 
      SqrtBox[
       RowBox[{"P", "(", "t", ")"}]], 
      SqrtBox[
       RowBox[{"I", "(", "t", ")"}]]}], "-", 
     RowBox[{"c", " ", 
      RowBox[{"P", "(", "t", ")"}], 
      RowBox[{"T", "(", "t", ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "646fc65f-23dd-b345-afb1-9d69cb03ce83"],
 " \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"d", " ", "I"}], 
     RowBox[{"d", " ", "t"}]], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["g", "I"], 
      RowBox[{"I", "(", "t", ")"}]}], "+", 
     RowBox[{"m", 
      SqrtBox[
       RowBox[{"I", "(", "t", ")"}]], 
      SqrtBox[
       RowBox[{"P", "(", "t", ")"}]]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8af9e89e-9198-644c-9f89-9c295f3cb730"],
 " \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"d", " ", "T"}], 
     RowBox[{"d", " ", "t"}]], "=", 
    RowBox[{
     RowBox[{
      FractionBox["a", 
       RowBox[{"l", "+", 
        SqrtBox[
         RowBox[{"P", "(", "t", ")"}]]}]], 
      SqrtBox[
       RowBox[{"P", "(", "t", ")"}]], 
      RowBox[{"T", "(", "t", ")"}]}], "-", 
     RowBox[{"b", " ", 
      RowBox[{"P", "(", "t", ")"}], 
      RowBox[{"T", "(", "t", ")"}]}], "-", 
     RowBox[{"f", " ", 
      RowBox[{"T", "(", "t", ")"}]}], "+", 
     RowBox[{"f", " ", 
      SubscriptBox["T", "0"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "827e9eb7-1b6f-004f-8a00-07f4569768ee"],
